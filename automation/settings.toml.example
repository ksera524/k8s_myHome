# k8s_myHome 自動化設定ファイル（サンプル）
# このファイルを automation/settings.toml としてコピーし、環境差分だけを設定します。
# settings.toml は Git 管理外です。secret 本文はコミットしないでください。

[kubernetes]
# SSH 接続ユーザー
user = "k8suser"
# SSH 秘密鍵パス。未指定時は ssh の既定設定を使います。
ssh_key_path = "/home/k8suser/.ssh/id_ed25519"

[upgrade]
# Kubernetes upgrade 設定
# 例: "v1.33.7"
target_version = ""
# 未指定時は target_version から minor channel を自動推定します。
# 例: "v1.33"
apt_channel = ""
gate_retries = 3
gate_retry_wait_seconds = 30

# containerd 更新設定
containerd_package = "containerd.io"
containerd_source_channel = "docker"
containerd_current_version = "1.7.28-0ubuntu1~24.04.2"
containerd_target_version = "2.2.3-1~ubuntu.24.04~noble"
containerd_canary_node = "k8s-worker2"

[network]
# Kubernetes ノードIP
control_plane_ip = "192.168.122.10"
worker_1_ip = "192.168.122.11"
worker_2_ip = "192.168.122.12"

[host_setup]
# setup-storage.sh を使う場合のみ指定します。
# 例: "sdb", "sdc", "nvme0n1"
usb_device_name = ""

[pulumi]
# External Secrets Operator bootstrap 用。環境変数 PULUMI_ACCESS_TOKEN でも指定できます。
access_token = ""
organization = "ksera"
project = "k8s"
environment = "secret"

[github]
# ArgoCD OAuth / ARC GitHub App 用の非機密ユーザー名
# add-runner.sh が Runner 定義登録と workflow 生成に使用します
username = ""

# make add-runners-all で一括追加するリポジトリ
# 形式: ["repo", min, max, "description", "latest"]
# arc_repositories = [
#   ["blog", 0, 1, "blogアプリ", "latest"],
#   ["cooklog", 0, 1, "cooklogアプリ", "latest"],
# ]

[automation]
# setup-storage.sh のデバイス上書き確認を自動承認する場合のみ true。
auto_confirm_overwrite = false
