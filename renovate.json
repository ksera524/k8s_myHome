{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "automerge": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "enabledManagers": [
    "kubernetes",
    "argocd",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/charts/**",
    "**/upstream/**",
    "tasks/**",
    "automation/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^manifests/.+\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^manifests/bootstrap/applications/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "ローカル GitOps HEAD と自作 latest は固定する",
      "matchCurrentValue": "/^(HEAD|latest)$/",
      "enabled": false
    },
    {
      "description": "private Harbor のアプリ配布はアプリ側 workflow が管理",
      "matchPackageNames": [
        "/^harbor\\.qroksera\\.com\\//"
      ],
      "enabled": false
    },
    {
      "description": "major 更新は個別 PR で確認",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "ログ基盤の更新を同じ PR で検証",
      "matchPackageNames": [
        "grafana/loki",
        "grafana/alloy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "logging stack"
    },
    {
      "description": "VictoriaMetrics と vmalert の版を揃える",
      "matchPackageNames": [
        "victoriametrics/victoria-metrics",
        "victoriametrics/vmalert"
      ],
      "groupName": "VictoriaMetrics"
    },
    {
      "description": "NGF の OCI source は chart 名を含むため lookup の重複を補正",
      "matchManagers": [
        "argocd"
      ],
      "matchPackageNames": [
        "ghcr.io/nginx/charts/nginx-gateway-fabric/nginx-gateway-fabric"
      ],
      "overridePackageName": "ghcr.io/nginx/charts/nginx-gateway-fabric"
    },
    {
      "description": "Crunchy の各イメージは PGO chart の推奨構成から同期する",
      "matchManagers": [
        "kubernetes"
      ],
      "matchPackageNames": [
        "/^registry\\.developers\\.crunchydata\\.com/crunchydata//"
      ],
      "enabled": false
    },
    {
      "description": "PGO chart を起点に PostgreSQL 基盤を一括更新する",
      "matchPackageNames": [
        "registry.developers.crunchydata.com/crunchydata/pgo"
      ],
      "groupName": "PostgreSQL stack",
      "automerge": false,
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^manifests/platform/pgo/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "name: pgo\\s+repo: oci://registry\\.developers\\.crunchydata\\.com/crunchydata\\s+version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "registry.developers.crunchydata.com/crunchydata/pgo",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
