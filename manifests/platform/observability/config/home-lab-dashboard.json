    {
      "id": 7,
      "type": "row",
      "title": "ノードの実使用量（上のノード選択に連動）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "CPU 使用率",
      "description": "ノード全体のCPU使用量 ÷ CPU capacity。新規収集開始前の履歴はありません。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(node) (rate(node_cpu_usage_seconds_total{job=\"kubelet-resources\",node=~\"$node\"}[$__rate_interval])) / on(node) max by(node) (kube_node_status_capacity{resource=\"cpu\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "メモリ使用率（working set）",
      "description": "working set ÷ ノード物理メモリ capacity。回収可能なキャッシュの一部も含みます。",
