    {
      "id": 11,
      "title": "CPU requests / allocatable",
      "description": "Pending / Running Pod の通常コンテナの requests 合計。init container・Pod overhead は含まず、スケジューラーの厳密な予約量とは異なります。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(node) (kube_pod_container_resource_requests{resource=\"cpu\",unit=\"core\",node=~\"$node\"} and on(namespace,pod) (kube_pod_status_phase{phase=~\"Pending|Running\"} == 1)) / on(node) max by(node) (kube_node_status_allocatable{resource=\"cpu\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
