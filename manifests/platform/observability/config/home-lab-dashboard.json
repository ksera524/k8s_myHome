{
  "uid": "home-lab-overview",
  "title": "Home Lab Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "home-lab"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Ready ノード数",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "{{namespace}} {{deployment}} {{pod}} {{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "利用可能な Deployment replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,deployment) (kube_deployment_status_replicas_available)",
          "legendFormat": "{{namespace}} {{deployment}} {{pod}} {{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "コンテナ再起動（1時間）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod) (increase(kube_pod_container_status_restarts_total[1h]))",
          "legendFormat": "{{namespace}} {{deployment}} {{pod}} {{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "PVC 使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - min by(namespace,persistentvolumeclaim) (kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes))",
          "legendFormat": "{{namespace}} {{deployment}} {{pod}} {{persistentvolumeclaim}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod ログ（namespace を選択）",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\"}"
        }
      ]
    }
  ]
}
