{
  "uid": "home-lab-overview",
  "title": "01 全体概要",
  "description": "GitOps 管理。メトリクスは30秒間隔で収集。上部リンクから詳細へ移動できます。",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "home-lab"
  ],
  "links": [
    {
      "title": "01 全体概要",
      "type": "link",
      "url": "/d/home-lab-overview",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "02 アプリ・ログ",
      "type": "link",
      "url": "/d/home-lab-workloads",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "03 ストレージ",
      "type": "link",
      "url": "/d/home-lab-storage",
      "keepTime": true,
