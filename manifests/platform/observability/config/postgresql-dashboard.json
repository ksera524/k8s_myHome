    {
      "id": 2,
      "type": "table",
      "title": "接続・TLS",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-registry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT current_database() AS database, current_user AS username, version() AS version, ssl, s.version AS tls_version FROM pg_stat_ssl s WHERE pid = pg_backend_pid();"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
