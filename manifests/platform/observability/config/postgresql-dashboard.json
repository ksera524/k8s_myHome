    {
      "id": 3,
      "type": "table",
      "title": "DB 容量・接続数",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-registry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT datname AS database, pg_database_size(datname) AS size_bytes, numbackends AS connections, xact_commit, xact_rollback, deadlocks FROM pg_stat_database WHERE datname = current_database();"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "テーブル容量・推定行数",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-registry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT schemaname, relname AS table_name, n_live_tup AS estimated_rows, pg_total_relation_size(relid) AS total_bytes, n_dead_tup AS dead_rows, last_autovacuum FROM pg_stat_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 100;"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "接続・実行中 SQL",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgresql-registry"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgresql-registry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pid, usename, application_name, client_addr::text, state, wait_event_type, wait_event, EXTRACT(EPOCH FROM (now() - query_start)) AS query_age_seconds, left(query, 500) AS query FROM pg_stat_activity WHERE datname = current_database() AND pid <> pg_backend_pid() ORDER BY query_start NULLS LAST LIMIT 50;"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
