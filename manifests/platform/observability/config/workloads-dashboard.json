{
  "uid": "home-lab-workloads",
  "title": "02 アプリ・ログ",
  "description": "GitOps 管理。Namespace → 種類 → Workload → Pod で絞り込み。選択期間内の所有関係を使用。ログ保持7日。",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "home-lab"
  ],
  "links": [
    {
      "title": "01 全体概要",
      "type": "link",
      "url": "/d/home-lab-overview",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "02 アプリ・ログ",
      "type": "link",
      "url": "/d/home-lab-workloads",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "03 ストレージ",
      "type": "link",
      "url": "/d/home-lab-storage",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "04 PostgreSQL / SQL",
      "type": "link",
      "url": "/d/home-lab-postgresql"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(kube_namespace_status_phase, namespace)",
          "refId": "var-namespace"
        },
        "definition": "label_values(kube_namespace_status_phase, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workload_kind",
        "label": "種類",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(count by (workload_kind) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\"}[$__range])))",
          "refId": "var-workload_kind"
        },
        "definition": "query_result(count by (workload_kind) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\"}[$__range])))",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/workload_kind=\"([^\"]+)\"/"
      },
      {
        "name": "workload",
        "label": "Workload",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(count by (workload) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\"}[$__range])))",
          "refId": "var-workload"
        },
        "definition": "query_result(count by (workload) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\"}[$__range])))",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/workload=\"([^\"]+)\"/"
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(count by (pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\"}[$__range])))",
          "refId": "var-pod"
        },
        "definition": "query_result(count by (pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\"}[$__range])))",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/pod=\"([^\"]+)\"/"
      },
      {
        "name": "log_pod",
        "label": "ログ対象",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(label_join(max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range])), \"namespace_pod\", \"/\", \"namespace\", \"pod\"))",
          "refId": "var-log_pod"
        },
        "definition": "query_result(label_join(max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range])), \"namespace_pod\", \"/\", \"namespace\", \"pod\"))",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/namespace_pod=\"([^\"]+)\"/",
        "hide": 2,
        "skipUrlSync": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running Pod",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((kube_pod_status_phase{namespace=~\"$namespace\",pod=~\"$pod\",phase=\"Running\"}) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))) or vector(0)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Pending Pod",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((kube_pod_status_phase{namespace=~\"$namespace\",pod=~\"$pod\",phase=\"Pending\"}) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))) or vector(0)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "再起動（1時間）",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"}[1h])) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))) or vector(0)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "不足 Deployment replica",
      "description": "選択した Workload / Pod に属する Deployment の不足 replica。対象外の場合は0。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((clamp_min(kube_deployment_spec_replicas{namespace=~\"$namespace\"} - kube_deployment_status_replicas_available{namespace=~\"$namespace\"}, 0)) and on(namespace,deployment) max by (namespace, deployment) (label_replace(max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",workload_kind=\"Deployment\",pod=~\"$pod\"}[$__range]), \"deployment\", \"$1\", \"workload\", \"(.+)\"))) or vector(0)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Pod ごとの実使用量（上位10件）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "CPU 使用量（cores）",
      "description": "1 core = CPU 1個分。requests や limits ではなく実使用量です。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(namespace,pod) ((rate(pod_cpu_usage_seconds_total{job=\"kubelet-resources\",namespace=~\"$namespace\",pod=~\"$pod\"}[$__rate_interval])) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "メモリ使用量（working set）",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, max by(namespace,pod) ((pod_memory_working_set_bytes{job=\"kubelet-resources\",namespace=~\"$namespace\",pod=~\"$pod\"}) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "安定性・定期処理",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "コンテナ再起動（1時間・上位10件）",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(namespace,pod) ((increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"}[1h])) and on(namespace,pod) max by(namespace,pod) (max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",pod=~\"$pod\"}[$__range]))))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "CronJob の最終成功からの時間",
      "description": "選択した Workload / Pod に属する CronJob。未成功・対象外は表示されません。",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - kube_cronjob_status_last_successful_time{namespace=~\"$namespace\"}) and on(namespace,cronjob) max by (namespace, cronjob) (label_replace(max_over_time(kube_pod_workload_info{namespace=~\"$namespace\",workload_kind=~\"$workload_kind\",workload=~\"$workload\",workload_kind=\"CronJob\",pod=~\"$pod\"}[$__range]), \"cronjob\", \"$1\", \"workload\", \"(.+)\"))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "データなし",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "cronjob": true,
              "Value": true
            },
            "indexByName": {
              "namespace": 0,
              "cronjob": 1,
              "Value": 2
            },
            "renameByName": {
              "Value": "最終成功からの経過時間"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "row",
      "title": "選択した Workload / Pod のログ",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "title": "Workload / Pod ログ",
      "description": "Namespace → 種類 → Workload → Pod と期間で絞り込み。Pod の All は選択した Workload 配下の全件。ログ保持7日。所有関係の収集前に消えた Pod は候補に出ません。",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\",pod=~\"$pod\"} | label_format namespace_pod=\"{{.namespace}}/{{.pod}}\" | namespace_pod=~\"$log_pod\" | drop namespace_pod",
          "maxLines": 300
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
